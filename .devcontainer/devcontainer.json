{
  "name": "Aplikasi POS (Laravel 13 + React)",
  "image": "mcr.microsoft.com/devcontainers/php:8.4",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Aplikasi POS", "onAutoForward": "openBrowser" },
    "8000": { "label": "API Laravel", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/README.md"] }
  }
}
